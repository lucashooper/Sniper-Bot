# Copy to .env (never commit .env). The engine reads it from the repo root.

# --- Solana RPC -------------------------------------------------------------
# Leave empty to run the synthetic market (paper trading, no network needed).
# Helius example: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=
# WebSocket endpoint for log streaming. Helius: wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_WS_URL=
# Optional: only needed if your RPC is not a Helius URL but you still want Helius fee estimates.
HELIUS_API_KEY=

# --- Jito ----------------------------------------------------------------------
# Pick the block engine nearest your machine:
#   https://amsterdam.mainnet.block-engine.jito.wtf   https://frankfurt.mainnet.block-engine.jito.wtf
#   https://ny.mainnet.block-engine.jito.wtf          https://slc.mainnet.block-engine.jito.wtf
#   https://tokyo.mainnet.block-engine.jito.wtf       https://london.mainnet.block-engine.jito.wtf
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Optional: a Jito auth UUID raises your bundle rate limit. Not needed to start.
JITO_AUTH_UUID=
# Fast send mode (default) uses Helius Sender: free on every Helius plan, no key needed. Override for a regional
# endpoint near the engine host, e.g. http://ewr-sender.helius-rpc.com/fast
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast

# --- Keys -----------------------------------------------------------------------
# Encrypts every wallet key at rest (AES-256-GCM, scrypt-derived). 12+ characters.
# Lose this and the stored keys cannot be decrypted: keep your own key backups.
KEYSTORE_PASSPHRASE=

# --- Safety switches --------------------------------------------------------------
# Live trading is impossible unless this is true, whatever the dashboard toggle says.
ALLOW_LIVE_TRADING=false

# --- Engine API -------------------------------------------------------------------
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8787
# Optional bearer token for the engine API; paste the same value in the dashboard's Settings page.
ENGINE_API_TOKEN=
# Browser origins allowed to call the engine (comma separated).
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where engine/data lives (encrypted keystore, wallets, settings, ledger). The Docker image uses /data.
ENGINE_DATA_DIR=

# --- Supabase (engine side) -------------------------------------------------------
# Turns on owner-only sign-in and an off-host backup of engine/data. Required when the engine is public.
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key. ENGINE HOST ONLY. Never put this on Netlify.
SUPABASE_SECRET_KEY=
# The one account allowed to drive the engine.
OWNER_EMAIL=

# --- Dashboard (dashboard/.env.local locally, Netlify environment variables in production) --------
# NEXT_PUBLIC_ENGINE_URL=https://your-engine.up.railway.app
# NEXT_PUBLIC_SUPABASE_URL=https://wsgytasfhjxoamlrokwa.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (public by design; RLS protects the data)
